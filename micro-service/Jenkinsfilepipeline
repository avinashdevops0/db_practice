pipeline {
    agent any
    stages {
        stage('Clean workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout Code') {
            steps {
                git branch: 'db',
                    url: 'https://github.com/avinashdevops0/db_practice.git'
            }
        }
        stage('Build Docker Images') {
            steps {
                script {
                    // Build images for each microservice
                    dir('micro-service/db-a') {
                        sh 'docker build --no-cache -t db-a-image .'
                    }
                    dir('micro-service/service-a') {
                        sh 'docker build --no-cache -t service-a-image .'
                    }
                    dir('micro-service/service-b') {
                        sh 'docker build --no-cache -t service-b-image .'
                    }
                    dir('micro-service/db-b') {
                        sh 'docker build --no-cache -t db-b-image .'
                    }
                }
            }
        }
        stage('Run Docker Containers') {
            steps {
                script {
                    // Create a Docker network
                    sh 'docker network create microservices-network || true'
                    
                    // Run DB containers
                    sh 'docker run -d --name mysql-db-a --network microservices-network db-a-image'
                    sh 'docker run -d --name mysql-db-b --network microservices-network db-b-image'

                    // Run Service containers
                    sh 'docker run -d --name service-a-container --network microservices-network -p 3000:3000 service-a-image'
                    sh 'docker run -d --name service-b-container --network microservices-network -p 4000:4000 service-b-image'
                }
            }
        }
    }
}
